# Copy to .env (git-ignored) and adjust. Every setting is optional.

# Where to listen. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to the LAN.
HOST=127.0.0.1
PORT=7860

# State: SQLite database, the 0600 secrets file, the secret key and the TLS files (tls/).
DATA_DIR=data
# Empty = SQLite in DATA_DIR. PostgreSQL: postgresql+psycopg://user:password@host:5432/forgeyard
# (install with `uv sync --extra postgres`).
DATABASE_URL=

# The address people and agents open. Its host is always accepted; set-password links and the
# machine join command use it (a LAN or Tailscale address, so other machines can reach it).
PUBLIC_URL=
# Other host names to answer to (comma-separated). localhost and IP addresses always work;
# any other Host header gets 421.
ALLOWED_HOSTS=
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are believed (comma-separated IPs).
TRUSTED_PROXIES=

# HTTPS (docs/https-and-trust.md). on (default): Forgeyard's own certificate authority, made in
# DATA_DIR/tls on the first start, or your own certificate below. off: plain HTTP, only behind a
# proxy that terminates TLS (admins are warned while pages arrive over plain HTTP).
TLS=on
# Your own certificate (both or neither), and optionally the CA that issued it (agents pin it).
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=
# More names or IP addresses for Forgeyard's own server certificate, comma-separated.
TLS_EXTRA_NAMES=

# The key that encrypts stored secrets (Hugging Face tokens, replica keys, workload environment
# values). Empty: DATA_DIR/secret.key, made on the first start (0600). Back it up apart from the
# database. FORGEYARD_SECRET_KEY (base64, 32 bytes) gives the key itself instead.
SECRET_KEY_FILE=

# First run: create the owner from these instead of the /setup page.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Pin the one-time setup token instead of generating one.
FORGEYARD_SETUP_TOKEN=

# Self-registration: off (default) or approval (new accounts wait for an admin).
REGISTRATION=off

SESSION_IDLE_MINUTES=120
SESSION_MAX_DAYS=7
# auto = Secure cookies when the request came over https; true / false to force.
COOKIE_SECURE=auto

# API requests per minute per client IP (0 = off).
RATE_LIMIT_PER_MINUTE=600
# Failed sign-ins per account before each further try waits (2 s, doubling, max 5 min).
LOGIN_FREE_FAILURES=5
# Failed sign-ins per IP within 15 minutes before that IP waits.
LOGIN_IP_FAILURES=30

# Machines: how often agents send a heartbeat, and how long a silent machine stays online.
AGENT_HEARTBEAT_SECONDS=10
AGENT_OFFLINE_SECONDS=30
# The agent image in the Machines page's `docker run` (Add a machine -> Docker). Empty: the published
# docker.io/<namespace>/forgeyard-agent at this server's version, or a local build while none is
# published. A mirror or private registry, a tag or a digest: registry.example.org/forgeyard/forgeyard-agent@sha256:...
AGENT_IMAGE=

# Models (M3). Where Hugging Face models are inspected and downloaded from (a mirror can go here).
HF_ENDPOINT=https://huggingface.co
# Model sources on private addresses and plain http: only for a LAN mirror (agents need
# --allow-private-model-hosts too). Private, loopback and metadata addresses are refused otherwise.
MODEL_ALLOW_PRIVATE_HOSTS=false
# Initial allowlists (admins change them on the Models page): hosts for GGUF URLs, directories for
# local:// models, comma-separated.
MODEL_URL_HOSTS=
MODEL_LOCAL_DIRS=
# GPU memory a replica's CUDA context takes on top of its own (0.4 GiB measured on an A100), and
# memory always left free on a card when placing replicas.
GPU_CONTEXT_MIB=400
VRAM_HEADROOM_MIB=512

# Gateway (M4), /v1. Seconds to connect to a replica before trying the next one, and how long a
# replica may take to send its answer's headers or the next piece of a stream.
GATEWAY_CONNECT_TIMEOUT=5
GATEWAY_READ_TIMEOUT=600
# The largest request body (an audio file for transcription is the big one), in MB.
GATEWAY_MAX_BODY_MB=32
# Initial limits for API keys, per minute (admins change them on the API keys page). DEFAULT: what a
# key without its own limit gets; MAX: the most a user may give their own key. 0: none.
GATEWAY_DEFAULT_RPM=0
GATEWAY_DEFAULT_TPM=0
GATEWAY_MAX_RPM=0
GATEWAY_MAX_TPM=0
# How often usage counted in memory is written to the database (seconds).
USAGE_FLUSH_SECONDS=5
