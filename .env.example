# Copy to .env (git-ignored) and adjust. Every setting is optional.

# Where to listen. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to the LAN.
HOST=127.0.0.1
PORT=7860

# State: SQLite database and the 0600 secrets file.
DATA_DIR=data
# Empty = SQLite in DATA_DIR. PostgreSQL: postgresql+psycopg://user:password@host:5432/forgeyard
# (install with `uv sync --extra postgres`).
DATABASE_URL=

# The address people and agents open. Its host is always accepted; set-password links and the
# machine join command use it (a LAN or Tailscale address, so other machines can reach it).
PUBLIC_URL=
# Other host names to answer to (comma-separated). localhost and IP addresses always work;
# any other Host header gets 421.
ALLOWED_HOSTS=
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are believed (comma-separated IPs).
TRUSTED_PROXIES=

# First run: create the owner from these instead of the /setup page.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Pin the one-time setup token instead of generating one.
FORGEYARD_SETUP_TOKEN=

# Self-registration: off (default) or approval (new accounts wait for an admin).
REGISTRATION=off

SESSION_IDLE_MINUTES=120
SESSION_MAX_DAYS=7
# auto = Secure cookies when the request came over https; true / false to force.
COOKIE_SECURE=auto

# API requests per minute per client IP (0 = off).
RATE_LIMIT_PER_MINUTE=600
# Failed sign-ins per account before each further try waits (2 s, doubling, max 5 min).
LOGIN_FREE_FAILURES=5
# Failed sign-ins per IP within 15 minutes before that IP waits.
LOGIN_IP_FAILURES=30

# Machines: how often agents send a heartbeat, and how long a silent machine stays online.
AGENT_HEARTBEAT_SECONDS=10
AGENT_OFFLINE_SECONDS=30

# Models (M3). Where Hugging Face models are inspected and downloaded from (a mirror can go here).
HF_ENDPOINT=https://huggingface.co
# Model sources on private addresses and plain http: only for a LAN mirror (agents need
# --allow-private-model-hosts too). Private, loopback and metadata addresses are refused otherwise.
MODEL_ALLOW_PRIVATE_HOSTS=false
# Initial allowlists (admins change them on the Models page): hosts for GGUF URLs, directories for
# local:// models, comma-separated.
MODEL_URL_HOSTS=
MODEL_LOCAL_DIRS=
# GPU memory a replica's CUDA context takes on top of its own (0.4 GiB measured on an A100), and
# memory always left free on a card when placing replicas.
GPU_CONTEXT_MIB=400
VRAM_HEADROOM_MIB=512
