# Copy to .env (git-ignored) and adjust. Every setting is optional: the defaults work for one server
# on your network. Restart the server after a change. docs/guide/reference.md describes each one.
#
# Units: durations in seconds unless the name says MINUTES or DAYS; sizes in MiB (also where a name
# says MB). In limits 0 means "no limit"; an empty value means "the default" or "none".
# The server warns at start about a name it does not know (with "did you mean"), and admins see the
# same warnings under Get started -> Setup health.

# ============================================================================ common settings

# Where to listen. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to the LAN (needed as soon as
# an agent on another machine joins).
HOST=127.0.0.1
PORT=7860

# The address people and agents open, e.g. https://192.168.1.20:7860. Its host is always accepted;
# set-password links, the machine join command and the gateway address use it. Empty: the address
# each browser used, which is wrong for other machines when you opened Forgeyard as 127.0.0.1.
PUBLIC_URL=

# State: SQLite database, the 0600 secrets file, the secret key and the TLS files (tls/). Relative
# to the folder the server starts in.
DATA_DIR=data
# Empty = SQLite in DATA_DIR. PostgreSQL: postgresql+psycopg://user:password@host:5432/forgeyard
# (install with `uv sync --extra postgres`).
DATABASE_URL=

# HTTPS (docs/https-and-trust.md). on (default): Forgeyard's own certificate authority, made in
# DATA_DIR/tls on the first start, or your own certificate below. off: plain HTTP, only behind a
# proxy that terminates TLS (admins are warned while pages arrive over plain HTTP).
TLS=on
# Your own certificate: both files or neither (one alone stops the start), and optionally the CA
# that issued it (agents pin it). All three are ignored with TLS=off.
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=

# Self-registration: off (default) or approval (new accounts wait for an admin).
REGISTRATION=off

# Where Hugging Face models are inspected and downloaded from (a mirror can go here).
HF_ENDPOINT=https://huggingface.co

# Requests to cloud providers go through this proxy (http://host:port) when set. A proxy from the
# environment (HTTPS_PROXY) is never used for them.
EGRESS_PROXY=

# ============================================================================ advanced settings
# The defaults are fine for almost everyone. Uncomment a line to change it.

# --- network
# Other host names to answer to (comma-separated). localhost and IP addresses always work; any other
# Host header gets 421.
# ALLOWED_HOSTS=
# Reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are believed (comma-separated IPs).
# TRUSTED_PROXIES=
# More names or IP addresses for Forgeyard's own server certificate, comma-separated (ignored with
# your own certificate).
# TLS_EXTRA_NAMES=

# --- data and secrets
# The key that encrypts stored secrets (Hugging Face tokens, replica keys, workload environment
# values, provider keys). Empty: DATA_DIR/secret.key, made on the first start (0600). Back it up
# apart from the database.
# SECRET_KEY_FILE=
# Or the key itself (base64 of 32 bytes), never written to disk. Set one of the two, not both.
# FORGEYARD_SECRET_KEY=

# --- accounts and sign-in
# First run only: create the owner from these instead of the /setup page. Remove them afterwards
# (the password would stay here in plain text).
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Pin the one-time setup token instead of generating one (no use once setup is done).
# FORGEYARD_SETUP_TOKEN=
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_DAYS=7
# auto = Secure cookies when the request came over https; true / false to force.
# COOKIE_SECURE=auto
# Requests per minute per client IP to the web UI's API (/api, not the gateway /v1, which has per-key
# limits). 0 = off.
# RATE_LIMIT_PER_MINUTE=600
# Failed sign-ins per account before each further try waits (2 s, doubling, max 5 min).
# LOGIN_FREE_FAILURES=5
# Failed sign-ins per IP within 15 minutes before that IP waits.
# LOGIN_IP_FAILURES=30

# --- machines
# How often agents send a heartbeat, and how long a silent machine stays online. Keep the offline
# time at least 2.5 heartbeats long, or machines flap.
# AGENT_HEARTBEAT_SECONDS=10
# AGENT_OFFLINE_SECONDS=30

# --- models
# Model sources on private addresses and plain http: only for a LAN mirror (agents need
# --allow-private-model-hosts too). Private, loopback and metadata addresses are refused otherwise.
# MODEL_ALLOW_PRIVATE_HOSTS=false
# First values only (admins change them on Models -> Model sources, and then these are ignored):
# hosts for GGUF URLs, directories for local:// models, comma-separated.
# MODEL_URL_HOSTS=
# MODEL_LOCAL_DIRS=
# GPU memory (MiB) a replica's CUDA context takes on top of its own (0.4 GiB measured on an A100), and
# memory (MiB) always left free on a card when placing replicas.
# GPU_CONTEXT_MIB=400
# VRAM_HEADROOM_MIB=512

# --- gateway (/v1)
# Seconds to connect to a replica before trying the next one, and how long a replica may take to send
# its answer's headers or the next piece of a stream.
# GATEWAY_CONNECT_TIMEOUT=5
# GATEWAY_READ_TIMEOUT=600
# The largest request body (an audio file for transcription is the big one), in MiB.
# GATEWAY_MAX_BODY_MB=32
# First values of the limits for API keys, per minute (admins change them on API keys -> Limits for
# keys, and then these are ignored). DEFAULT: what a key without its own limit gets; MAX: the most a
# user may give their own key. 0: none.
# GATEWAY_DEFAULT_RPM=0
# GATEWAY_DEFAULT_TPM=0
# GATEWAY_MAX_RPM=0
# GATEWAY_MAX_TPM=0
# How often usage counted in memory is written to the database (seconds).
# USAGE_FLUSH_SECONDS=5

# --- cloud providers
# First values of the cloud setting for API keys: off, fallback or on (admins change them on API keys
# -> Cloud for keys, and then these are ignored). DEFAULT: what a new key gets; MAX: the most a user
# may give their own key.
# GATEWAY_CLOUD_DEFAULT=off
# GATEWAY_CLOUD_MAX=off
# Only these provider hosts, comma-separated (*.example.org for subdomains). Empty: any host.
# EGRESS_ALLOWED_HOSTS=
# A CA file to trust for providers on top of the system's (a company proxy that inspects TLS).
# EGRESS_CA_FILE=
# Providers outside your network on private or loopback addresses and plain http: for testing with a
# stand-in only. Link-local and metadata addresses stay refused.
# PROVIDER_ALLOW_PRIVATE_HOSTS=false
# Media in chat (1.3): the most the gateway downloads for one media URL, in MiB.
# MEDIA_FETCH_MAX_MB=20
# Let media URLs point at private or loopback addresses (an image server on your LAN). Link-local and
# metadata addresses stay refused.
# MEDIA_ALLOW_PRIVATE_HOSTS=false
# Seconds to connect to a provider before trying the next target.
# PROVIDER_CONNECT_TIMEOUT=10
# Seconds a provider may take for its answer's headers or the next piece of a stream (the default of
# each provider's Answer timeout).
# PROVIDER_READ_TIMEOUT=300
# A provider target that answered 429 or 5xx, or could not be reached, is tried last for this long
# (seconds; longer when its Retry-After says so, up to 5 minutes).
# PROVIDER_COOLDOWN_SECONDS=30
# When no other target is left, a Retry-After up to this many seconds is waited for once.
# PROVIDER_RETRY_AFTER_CAP=2
# Where "Refresh prices from OpenRouter" reads prices (no key is sent). Change it only for tests.
# OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
# Budgets reserve a cloud request's cost before it is sent; a request without max_tokens is reserved
# as if its answer had this many tokens.
# BUDGET_DEFAULT_MAX_TOKENS=4096
